* text=auto

# Repository configuration files stay LF on every platform.
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Windows PowerShell 5.1 scripts are checked out with CRLF.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Web and documentation files use LF.
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary formats
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.xlsx binary
*.xlsm binary
*.docx binary
*.pdf binary
